{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "**/.next/**",
      "**/.turbo/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/coverage/**",
      "pnpm-lock.yaml",
      "**/*.min.js"
    ]
  },
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  }
}
